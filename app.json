{
  "expo": {
    "name": "ClimaShield",
    "slug": "climashield",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon1.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#4B0082"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon1.png",
        "backgroundColor": "#4B0082"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.pratham_tiwari.climashield"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "e7ee36eb-b760-41e7-942f-05e119a44929"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow ClimaShield to access your location even when the app is closed.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ]
  }
}
